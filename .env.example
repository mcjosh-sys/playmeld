# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# Database
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Redis - for BullMQ queue (required for sync jobs)
# Local: redis://localhost:6379
# Upstash: rediss://... (with TLS)
# Vercel KV: use KV_URL or UPSTASH_REDIS_URL
REDIS_URL=redis://localhost:6379
# For Upstash Redis (alternative)
UPSTASH_REDIS_URL=
# Vercel KV (alternative)
KV_URL=

# Cron secret for Vercel crons (optional)
CRON_SECRET=

# Token Encryption (AES-256-GCM key, 32 bytes base64)
TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key

# OAuth - Auth providers (NextAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Music Providers
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Apple Music
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
# YouTube / Google for YouTube Music
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Paystack
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_WEBHOOK_SECRET=whsec_... # if using separate webhook secret, otherwise use secret key for HMAC verification

# Paystack Plans (create via npm run db:create-paystack-plans)
PAYSTACK_STARTER_MONTHLY_PLAN_CODE=
PAYSTACK_STARTER_YEARLY_PLAN_CODE=
PAYSTACK_PRO_MONTHLY_PLAN_CODE=
PAYSTACK_PRO_YEARLY_PLAN_CODE=
PAYSTACK_ENTERPRISE_MONTHLY_PLAN_CODE=
PAYSTACK_ENTERPRISE_YEARLY_PLAN_CODE=

# ngrok (for local OAuth callbacks)
NGROK_AUTHTOKEN=
NGROK_HOSTNAME=intensely-actual-chipmunk.ngrok-free.app

# Docker
DOCKER_BUILD=false
